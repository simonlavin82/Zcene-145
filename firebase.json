{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firestore-debug.log"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=86400"
          }
        ]
      },
      {
        "source": "/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/gemini/**",
        "run": {
          "serviceId": "zcene-backend-proxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/artist/**",
        "run": {
          "serviceId": "zcene-backend-proxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/label/**",
        "run": {
          "serviceId": "zcene-backend-proxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/og/**",
        "run": {
          "serviceId": "zcene-backend-proxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/app**",
        "run": {
          "serviceId": "zcene-backend-proxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/z/**",
        "run": {
          "serviceId": "zcene-backend-proxy",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
