{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firestore-debug.log"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/gemini/**",
        "run": {
          "serviceId": "zcene-backend-proxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/artist/**",
        "run": {
          "serviceId": "zcene-backend-proxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/app**",
        "run": {
          "serviceId": "zcene-backend-proxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/z/**",
        "run": {
          "serviceId": "zcene-backend-proxy",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
