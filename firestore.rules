rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. DEFAULT DENY
    // Firestore denies all requests by default when no rule matches.
    // No catch-all block is needed — only the explicit rules below grant access.
    // (The previous `allow read, write: if false` catch-all was redundant and has been removed.)

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'zcene.online@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['email']) &&
             data.keys().size() <= 20 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName == null || (data.displayName is string && data.displayName.size() <= 200))) &&
             (!('photoURL' in data) || (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000))) &&
             (!('createdAt' in data) || (data.createdAt is timestamp)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp)) &&
             (!('libraryArtists' in data) || (data.libraryArtists is string)) &&
             (!('libraryBaseGraph' in data) || (data.libraryBaseGraph == null || data.libraryBaseGraph is string)) &&
             (!('onboardingProgress' in data) || data.onboardingProgress is map) &&
             (!('deepCutsOpened' in data) || (data.deepCutsOpened is int)) &&
             (!('pageAuth' in data) || data.pageAuth is map) &&
             (!('tokenBalance' in data) || (data.tokenBalance is int && data.tokenBalance >= 0)) &&
             (!('lifetimeTokensPurchased' in data) || (data.lifetimeTokensPurchased is int && data.lifetimeTokensPurchased >= 0)) &&
             (!('lifetimeTokensSpent' in data) || (data.lifetimeTokensSpent is int && data.lifetimeTokensSpent >= 0)) &&
             (!('lastTopUpAt' in data) || (data.lastTopUpAt == null || data.lastTopUpAt is timestamp));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'seedArtists']) &&
             data.keys().size() <= 40 &&
             data.name is string && data.name.size() <= 512 &&
             data.seedArtists is string && data.seedArtists.size() <= 10000 &&
             // LEGACY full-blob fields (optional for backward compat)
             (!('graphData' in data) || (data.graphData == null || (data.graphData is string && data.graphData.size() <= 2097152))) &&
             (!('detailsCache' in data) || (data.detailsCache == null || data.detailsCache is string)) &&
             // NEW lightweight reference fields
             (!('cacheKey' in data) || (data.cacheKey is string && data.cacheKey.size() <= 512)) &&
             (!('canvasLayout' in data) || (data.canvasLayout is string)) &&
             (!('artistIds' in data) || (data.artistIds is list)) &&
             (!('activeNodes' in data) || (data.activeNodes is list)) &&
             (!('chatHistories' in data) || (data.chatHistories == null || data.chatHistories is string)) &&
             (!('discoveryFilters' in data) || (data.discoveryFilters is string)) &&
             (!('lastViewedStackCount' in data) || (data.lastViewedStackCount is int)) &&
             (!('isMagazineViewOpen' in data) || (data.isMagazineViewOpen is bool)) &&
             (!('authorId' in data) || (data.authorId is string)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp)) &&
             (!('anchorResolution' in data) || (data.anchorResolution == null || data.anchorResolution is string)) &&
             (!('generationType' in data) || (data.generationType == null || data.generationType is string)) &&
             (!('apiUsage' in data) || (data.apiUsage == null || data.apiUsage is map)) &&
             (!('tokensSpent' in data) || (data.tokensSpent == null || (data.tokensSpent is int && data.tokensSpent >= 0)));
    }

    function isValidStackItem(data) {
      return data.keys().hasAll(['id', 'type', 'dateSaved']) &&
             data.id is string &&
             data.type is string &&
             (data.dateSaved is int || data.dateSaved is timestamp) &&
             (!('link' in data) || data.link is string) &&
             (!('discoveredVia' in data) || data.discoveredVia is string);
    }

    function isValidSession(data) {
      return data.spiderwebData is string &&
             data.activeDeepCuts is list;
    }

    function isValidSharedZcene(data) {
      // graphData must exist (may be a lightweight stub '{}' for new-format shares)
      return data.keys().hasAll(['graphData', 'seedArtists', 'activeNodes']) &&
             data.graphData is string &&
             data.seedArtists is string &&
             data.activeNodes is list &&
             // NEW lightweight reference fields (optional)
             (!('cacheKey' in data) || (data.cacheKey is string && data.cacheKey.size() <= 512)) &&
             (!('canvasLayout' in data) || (data.canvasLayout is string)) &&
             (!('anchorResolution' in data) || (data.anchorResolution == null || data.anchorResolution is string));
    }

    // --- Core Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && 
                      isValidUser(incoming()) &&
                      (!('tokenBalance' in incoming()) || incoming().tokenBalance == 0) &&
                      (!('lifetimeTokensPurchased' in incoming()) || incoming().lifetimeTokensPurchased == 0) &&
                      (!('lifetimeTokensSpent' in incoming()) || incoming().lifetimeTokensSpent == 0);
      
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) &&
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['tokenBalance', 'lifetimeTokensPurchased', 'lifetimeTokensSpent', 'lastTopUpAt']);
      
      allow delete: if isOwner(userId) || isAdmin();

      match /tokenTransactions/{txId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow write: if false; // Exclusively written by Cloud Functions via Firebase Admin SDK
      }

      match /projects/{projectId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        
        allow create: if isOwner(userId) && 
                        isValidProject(incoming()) &&
                        (!('tokensSpent' in incoming()) || incoming().tokensSpent == null || incoming().tokensSpent == 0 || isAdmin());
        
        allow update: if isOwner(userId) && 
                        isValidProject(incoming()) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tokensSpent']) || isAdmin());
        
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /stack/{itemId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        
        allow create: if isOwner(userId) && 
                        isValidStackItem(incoming());
        
        allow update: if isOwner(userId) && 
                        isValidStackItem(incoming());
        
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /userSession/{sessionId} {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSession(incoming());
        allow update: if isOwner(userId) && isValidSession(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /sharedZcenes/{shareId} {
      allow get: if true;
      allow list: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
                      isValidSharedZcene(incoming()) &&
                      incoming().authorId == request.auth.uid;
      
      allow delete: if isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);
    }

    // Support for potential legacies or flat projects
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (
        (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        (resource.data.isPublic == true)
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);
    }
    
    // Explicit health check path
    match /test/connection {
      allow get: if true;
    }

    // --- Global Artist Cache ---
    // Top-level collection storing computed graph structures and Deep Cut metadata.
    // Keyed by a normalized artist+filter string for O(1) lookup before Gemini is called.
    match /artists/{cacheKey} {
      // Anyone (even guests) can read and query the global cache for instant hydration.
      allow read: if true;

      // Any authenticated user may CREATE a new entry on a cache miss.
      // The rule checks that the document does not already exist, preventing poisoning.
      // (Firestore enforces this via the `create` operation — not `update`.)
      allow create: if isSignedIn() &&
                       (
                         // Standard creation
                         (
                           incoming().keys().hasAll(['cacheKey', 'graphData', 'seedArtists', 'filters', 'cacheVersion']) &&
                           incoming().cacheKey == cacheKey &&
                           incoming().graphData is string &&
                           incoming().graphData.size() <= 2097152 &&
                           incoming().seedArtists is string &&
                           incoming().hitCount == 0
                         ) ||
                         // Evolved routing stub creation (unambiguous redirect or ambiguous candidate list)
                         (
                           incoming().cacheKey == cacheKey &&
                           (
                             (
                               incoming().keys().hasAll(['cacheKey', 'artistId', 'redirectTo', 'cacheVersion']) &&
                               incoming().redirectTo is string &&
                               incoming().redirectTo != ""
                             ) ||
                             (
                               ('_isStub' in incoming() && incoming()._isStub == true) &&
                               (
                                 ('redirectTo' in incoming() && incoming().redirectTo is string) ||
                                 ('candidates' in incoming() && incoming().candidates is list)
                               )
                             )
                           )
                         )
                       );

      // Authenticated users may update detailsCache (Phase 03 write-back) and hitCount (analytics).
      // They may also upgrade legacy cache entries (cacheVersion < 2) to version 2 by writing graphData and filters.
      // General modifications to graphData for version 2+ remain blocked to prevent graph poisoning.
      allow update: if isSignedIn() &&
                       (
                         // Case A: Standard metadata and telemetry updates on qualified cache docs
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['detailsCache', 'hitCount', 'cachedAt', 'candidates', '_isStub', 'isAmbiguous', 'redirectTo'])
                       ) || (
                          // Case B: Upgrade a sparse/legacy cache doc (< 2 version or skeleton layout)
                          (
                            (!('cacheVersion' in existing()) || existing().cacheVersion < 2) ||
                            (!('isDeep' in existing()) || existing().isDeep != true)
                          ) &&
                          incoming().cacheVersion == 2 &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['detailsCache', 'hitCount', 'graphData', 'cacheVersion', 'filters', 'cacheKey', 'artistId', 'seedArtists', 'cachedAt', 'isDeep'])
                       ) || (
                          // Case C: Convert a legacy/duplicate document to an evolved routing stub
                          (
                            (
                              'redirectTo' in incoming() &&
                              incoming().redirectTo is string &&
                              incoming().redirectTo != ""
                            ) ||
                            (
                              '_isStub' in incoming() &&
                              incoming()._isStub == true &&
                              'candidates' in incoming() &&
                              incoming().candidates is list
                            )
                          )
                       );

      // Only admins may delete cache entries (manual invalidation).
      allow delete: if isAdmin();
    }

    // --- Global Label Cache ---
    // Dedicated collection storing Deep Cut biographies and discographies for record labels.
    // Keyed by canonical normalized slug for O(1) global lookup across all Zcene projects.
    match /labels/{cacheKey} {
      allow read: if true;

      allow create: if isSignedIn() &&
                       (
                         (
                           incoming().keys().hasAll(['cacheKey', 'labelId', 'hitCount']) &&
                           incoming().cacheKey == cacheKey &&
                           incoming().hitCount == 0
                         ) ||
                         (
                           incoming().cacheKey == cacheKey &&
                           (
                             (
                               incoming().keys().hasAll(['cacheKey', 'redirectTo']) &&
                               incoming().redirectTo is string &&
                               incoming().redirectTo != ""
                             ) ||
                             (
                               ('_isStub' in incoming() && incoming()._isStub == true) &&
                               (
                                 ('redirectTo' in incoming() && incoming().redirectTo is string) ||
                                 ('candidates' in incoming() && incoming().candidates is list)
                               )
                             )
                           )
                         )
                       );

      allow update: if isSignedIn() &&
                       (
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['detailsCache', 'hitCount', 'cachedAt', 'cacheVersion', 'labelId', 'cacheKey', 'isDeep', 'graphData', 'synthesisRationale', 'filters', 'seedArtists', 'redirectTo', 'candidates', '_isStub', 'isAmbiguous'])
                       ) || (
                         (
                           'redirectTo' in incoming() &&
                           incoming().redirectTo is string &&
                           incoming().redirectTo != ""
                         ) ||
                         (
                           '_isStub' in incoming() &&
                           incoming()._isStub == true &&
                           'candidates' in incoming() &&
                           incoming().candidates is list
                         )
                       );

      allow delete: if isAdmin();
    }

    // --- Curation Jobs ---
    match /curationJobs/{jobId} {
      // Users can only read their own curation jobs, admins can read all
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can only create pending curation jobs owned by themselves
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().createdAt == request.time;
                       
      // Users can only cancel their own pending/processing jobs
      allow update: if isSignedIn() &&
                       resource.data.userId == request.auth.uid &&
                       incoming().userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                       incoming().status == 'cancelled';
                       
      // Only admins can delete jobs
      allow delete: if isAdmin();
    }

    // --- Admin Ledger & Telemetry (Phase 3) ---
    match /adminLedger/system {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /adminLedger/system/jitHeals/{healId} {
      allow read: if isAdmin();
      allow write: if false; // Exclusively written by Cloud Functions via Firebase Admin SDK
    }

    // --- Prepaid Token Economy Split-Debit & Deep Web Leases (Rule 43) ---
    match /curationSessions/{sessionId} {
      allow read, write: if false; // Exclusively managed by Cloud Functions via Firebase Admin SDK
    }

    match /deepWebSessions/{sessionId} {
      allow read, write: if false; // Exclusively managed by Cloud Functions & Cloud Run Proxy via Admin SDK
    }
  }
}
