{
  "name": "functions",
  "scripts": {
    "build": "mkdir -p src/services && cp ../services/errorTranslationLayer.ts src/services/errorTranslationLayer.ts && tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "@google/genai": "^1.22.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
