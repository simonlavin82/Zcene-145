{
  "name": "145-zcene",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --env-file=.env server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port $PORT",
    "lint": "eslint . && tsc --noEmit",
    "deploy:hosting": "npx firebase-tools deploy",
    "deploy:backend": "CLOUDSDK_PYTHON=/opt/homebrew/bin/python3.11 gcloud run deploy zcene-backend-proxy --source . --region us-central1 --project zcene-production --quiet",
    "deploy": "npm run build && npm run deploy:hosting && npm run deploy:backend",
    "seed:cache-hit": "node scripts/seed_cache_hit.cjs",
    "seed:cache-miss": "node scripts/seed_cache_miss.cjs",
    "test:regression": "node scratch/test_pipeline_regression.cjs",
    "test:serve": "concurrently \"node --env-file=.env server.js\" \"vite --mode test\""
  },
  "dependencies": {
    "@google/genai": "^1.22.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.0.0-beta.8",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.0.0",
    "http-proxy-middleware": "^4.0.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.5",
    "tailwindcss": "^4.0.0-beta.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^5.0.3",
    "concurrently": "^10.0.4",
    "eslint": "^10.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.1",
    "ts-jest": "^29.4.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  }
}
